{
  "PatientService": {
    "Path": "http://patient_service:8080/api/Patients"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "Host=postgres_db;Database=AuthServiceDb;Username=authservice_user;Password=authservice_pass"
  },
  "TokenOptions": {
    "Audience": "www.myapp.com",
    "Issuer": "www.myapp.com",
    "AccessTokenExpiration": 30,
    "RefreshTokenExpiration": 7,
    "SecurityKey": "MySuperSecretSecurityKey1234567890123456789012345678901234567890ABCDEF"
  },
  "S2SOptions": {
    "DefaultTokenExpirationMinutes": 60,
    "MaxTokenExpirationMinutes": 1440,
    "AllowedServices": [
      "ProductService",
      "CategoryService",
      "OrderService",
      "InventoryService",
      "PaymentService"
    ]
  },
  "MailSendGrid": {
    "UserName": "----",
    "SenderEmail": "----",
    "ApiKey": "----"
  }
}